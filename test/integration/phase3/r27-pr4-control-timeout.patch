From d56fbc69c4814d0e5e978cb18581a0fdd833ab95 Mon Sep 17 00:00:00 2001
From: Andrew Leech <andrew.leech@planetinnovation.com.au>
Date: Thu, 7 May 2026 19:15:06 +1000
Subject: [PATCH] host: Honour timeout_ms in tuh_control_xfer.

The timeout_ms field on tuh_xfer_t was previously a placeholder
("not supported yet"). The synchronous tuh_control_xfer path
(complete_cb == NULL) was a busy loop with no timeout, so any
device that NAK'd the control transfer indefinitely wedged the
caller. Honour the field. timeout_ms == 0 preserves the
historical "wait forever" default for callers that do not set
it; non-zero returns false with xfer->result =
XFER_RESULT_FAILED if the transfer does not complete in time,
and the EP0 channel is aborted via hcd_edpt_abort_xfer so a
subsequent control transfer on the same daddr can proceed.

The deadline timestamp is captured ONLY when a non-zero timeout
is requested. The wait-forever code path is bit-for-bit
identical to the historical loop body so there is no scheduling
impact on existing callers; an unconditional
tusb_time_millis_api() call before the loop was observed to
shift task scheduling enough to introduce a ~5% flake rate on
an mpy-pod ESP32-S3 cdc-acm cycled-close test.

Three existing tuh_xfer_t declarations (usbh.c
process_enumeration kick-off, hid_host.c hidh_set_config,
cdc_host.c cdch_set_config) used field-by-field assignment
instead of designated init, so the new timeout_ms field landed
on stack canary garbage. Convert all three to designated init.

Reproducer: any device that NAKs CLEAR_FEATURE(ENDPOINT_HALT)
on a bulk EP indefinitely (Pico CDC-ACM is one such device).
With timeout_ms set to e.g. 250, the call returns false within
250 ms and the EP0 channel is clean for reuse.

Signed-off-by: Andrew Leech <andrew.leech@planetinnovation.com.au>
---
 src/class/cdc/cdc_host.c | 13 ++++++-----
 src/class/hid/hid_host.c | 12 ++++++----
 src/host/usbh.c          | 49 +++++++++++++++++++++++++++++++++++-----
 src/host/usbh.h          |  2 +-
 4 files changed, 58 insertions(+), 18 deletions(-)

diff --git a/src/class/cdc/cdc_host.c b/src/class/cdc/cdc_host.c
index 35717ddf6..27bbdeecb 100644
--- a/src/class/cdc/cdc_host.c
+++ b/src/class/cdc/cdc_host.c
@@ -781,12 +781,13 @@ bool cdch_set_config(uint8_t daddr, uint8_t itf_num) {
   TU_ASSERT(p_cdc && p_cdc->serial_drid < SERIAL_DRIVER_COUNT);
   TU_LOG_CDC(p_cdc, "set config");
 
-  // fake transfer to kick-off process_set_config()
-  tuh_xfer_t xfer;
-  xfer.daddr = daddr;
-  xfer.result = XFER_RESULT_SUCCESS;
-  xfer.setup = &request;
-  xfer.user_data = 0; // initial state 0
+  // R27 bisect: designated init so timeout_ms field is zero.
+  tuh_xfer_t xfer = {
+    .daddr     = daddr,
+    .result    = XFER_RESULT_SUCCESS,
+    .setup     = &request,
+    .user_data = 0,
+  };
   cdch_process_set_config(&xfer);
 
   return true;
diff --git a/src/class/hid/hid_host.c b/src/class/hid/hid_host.c
index da776d04c..945f8f3dc 100644
--- a/src/class/hid/hid_host.c
+++ b/src/class/hid/hid_host.c
@@ -583,11 +583,13 @@ bool hidh_set_config(uint8_t daddr, uint8_t itf_num) {
   tusb_control_request_t request;
   request.wIndex = tu_htole16((uint16_t) itf_num);
 
-  tuh_xfer_t xfer;
-  xfer.daddr = daddr;
-  xfer.result = XFER_RESULT_SUCCESS;
-  xfer.setup = &request;
-  xfer.user_data = CONFG_SET_IDLE;
+  // R27 bisect: designated init so timeout_ms field is zero.
+  tuh_xfer_t xfer = {
+    .daddr     = daddr,
+    .result    = XFER_RESULT_SUCCESS,
+    .setup     = &request,
+    .user_data = CONFG_SET_IDLE,
+  };
 
   // fake request to kick-off the set config process
   process_set_config(&xfer);
diff --git a/src/host/usbh.c b/src/host/usbh.c
index 734024771..93226a311 100644
--- a/src/host/usbh.c
+++ b/src/host/usbh.c
@@ -764,13 +764,49 @@ bool tuh_control_xfer (tuh_xfer_t* xfer) {
 
     TU_ASSERT(usbh_setup_send(daddr, (uint8_t const *) &_usbh_epbuf.request));
 
+    // Honour xfer->timeout_ms. timeout_ms == 0 preserves the historical
+    // "wait forever" default for callers that do not initialise the
+    // field. Non-zero returns false with xfer->result =
+    // XFER_RESULT_FAILED if the device does not complete the control
+    // transfer in time. The caller is responsible for any further
+    // recovery (e.g. hcd_edpt_abort_xfer) on the EP0 channel.
+    //
+    // The deadline is captured ONLY when a non-zero timeout is
+    // requested. The wait-forever code path is bit-for-bit identical
+    // to the historical loop body so there is no scheduling impact on
+    // existing callers.
+    const uint32_t timeout_ms_local = xfer->timeout_ms;
+    uint32_t start_ms = 0;
+    if (timeout_ms_local > 0) {
+      start_ms = tusb_time_millis_api();
+    }
+
     while (result == XFER_RESULT_INVALID) {
       // Note: this can be called within an callback ie. part of tuh_task()
       // therefore event with RTOS tuh_task() still need to be invoked
       if (tuh_task_event_ready()) {
         tuh_task();
       }
-      // TODO probably some timeout to prevent hanged
+      if (timeout_ms_local > 0 && (tusb_time_millis_api() - start_ms) >= timeout_ms_local) {
+        // Timeout. Tear down the in-flight control xfer cleanly so a
+        // subsequent control xfer on the same daddr can proceed.
+        (void) osal_mutex_lock(_usbh_mutex, OSAL_TIMEOUT_WAIT_FOREVER);
+        if (ctrl_info->stage != CONTROL_STAGE_IDLE) {
+          ctrl_info->stage       = CONTROL_STAGE_IDLE;
+          ctrl_info->complete_cb = NULL;
+          ctrl_info->user_data   = 0;
+        }
+        (void) osal_mutex_unlock(_usbh_mutex);
+        // Best-effort: abort the EP0 channel so the hardware does not
+        // deliver a late completion into the now-idle control state.
+        hcd_edpt_abort_xfer(usbh_get_rhport(daddr), daddr, 0);
+        if (xfer->user_data != 0) {
+          *((xfer_result_t*) xfer->user_data) = XFER_RESULT_FAILED;
+        }
+        xfer->result     = XFER_RESULT_FAILED;
+        xfer->actual_len = 0;
+        return false;
+      }
     }
 
     // update transfer result, user_data is expected to point to xfer_result_t
@@ -1460,11 +1496,12 @@ static bool enum_new_device(hcd_event_t* event) {
     dev0_bus->speed = hcd_port_speed_get(dev0_bus->rhport);
     TU_LOG_USBH("%s Speed\r\n", tu_str_speed[dev0_bus->speed]);
 
-    // fake transfer to kick-off the enumeration process
-    tuh_xfer_t xfer;
-    xfer.daddr = 0;
-    xfer.result = XFER_RESULT_SUCCESS;
-    xfer.user_data = ENUM_ADDR0_DEVICE_DESC;
+    // R27 bisect: designated init so timeout_ms field is zero.
+    tuh_xfer_t xfer = {
+      .daddr     = 0,
+      .result    = XFER_RESULT_SUCCESS,
+      .user_data = ENUM_ADDR0_DEVICE_DESC,
+    };
     process_enumeration(&xfer);
   }
   #if CFG_TUH_HUB
diff --git a/src/host/usbh.h b/src/host/usbh.h
index 4b6747848..95f0a73d4 100644
--- a/src/host/usbh.h
+++ b/src/host/usbh.h
@@ -70,7 +70,7 @@ struct tuh_xfer_s {
   tuh_xfer_cb_t complete_cb;
   uintptr_t user_data;
 
-  // uint32_t timeout_ms;    // place holder, not supported yet
+  uint32_t timeout_ms;       // R27 bisect: field added, no logic change
 };
 
 // Subject to change
-- 
2.43.0

