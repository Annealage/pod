[micropython]
version = machine-usbhost@dfa0adc44 (andrewleech fork)
commit  = dfa0adc44662f377ef7ce3561b32004f481909e2
source  = https://github.com/andrewleech/micropython.git
branch  = machine-usbhost
notes   = Phase 3 P3.0 pivot to TinyUSB host: PR #7 against
          micropython/micropython, head dfa0adc44 as of 2026-04-29.
          Adds machine.USBHost() built on TinyUSB host with the
          shared shared/tinyusb/mp_usbh.{c,h} infra layer; pins the
          TinyUSB submodule at 0.20.0; provides USBHOST variant of
          ESP32_GENERIC_S3 (mpconfigvariant_USBHOST.cmake). Tested
          across STM32F4, RP2350 PIO USB, MIMXRT, and ESP32-S3 in
          PR #7. Previous pin was 8a56be66 (upstream MP master,
          v1.29.0-preview-69-g8a56be666); see this repo's commit
          history for the prior baseline. WS-B's usbhost backend
          rebuilds against TinyUSB host primitives instead of the
          IDF usb_host component.

[smoke-flash]
host          = laptop
target        = esp32-s3 (mpy-dev label)
target_serial = 5A46090178 (CH340N)
date          = 2026-04-29
result        = pass
notes         = MicroPython 1.29.0-preview boots on UART0 at 115200 8N1.
                Octal PSRAM detected, gc.mem_free() reports ~8.3 MiB
                free immediately after boot. CPU clock 240 MHz.
                Frozen `annealage_pod` package imports cleanly;
                annealage_pod.boot.up() prints "annealage_pod skeleton up" on
                the console. All four C user modules (usbip, dapprobe,
                uartbridge, slaveio) import and their start() functions
                emit ESP_LOGI lines on UART0.
                Custom partition table accepted by esptool, factory
                slot ~1.6 MiB used of 2 MiB; ota_0/ota_1/vfs allocated
                per spec.md §4.2.
