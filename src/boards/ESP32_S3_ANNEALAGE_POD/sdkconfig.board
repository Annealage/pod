# Annealage Pod (ESP32-S3-WROOM-1-N16R8) sdkconfig overlay.
#
# Layered on top of sdkconfig.base + sdkconfig.spiram_sx +
# sdkconfig.spiram_oct + sdkconfig.240mhz from the MicroPython esp32 port.
# Anything NOT set here keeps the MicroPython-port default.

# 16 MB octal flash at 80 MHz QIO (matches WROOM-1-N16R8).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=n
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Partition table per spec.md §4.2 (factory 2 M, ota_0 4 M, ota_1 4 M, vfs).
# Path is resolved relative to the IDF project_dir (= ports/esp32/), so we
# step out of src/micropython/ports/esp32/ to reach the board variant
# directory under src/boards/. Sdkconfig has no way to interpolate
# MICROPY_BOARD_DIR, so the path is hard-coded here.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../boards/ESP32_S3_ANNEALAGE_POD/partitions.csv"

# Bootloader app rollback: new OTA images mark themselves valid only
# after Wi-Fi connects and MP boot completes; failure rolls back.
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is already on in sdkconfig.base
# but make it explicit here too in case base shifts.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Task watchdog: 30 s second-tier timeout per spec §6.2. The hardware
# RTC-WDT remains at IDF default.
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# USB host stack will be enabled in Phase 2 along with TinyUSB host. For
# the Phase 1 skeleton we leave the USB peripheral disabled. The pins
# (GPIO19/20) are still reserved at the board level via mpconfigboard.h
# disabling USBDEV / Serial-JTAG.

# UART console on UART0 GPIO43/44 (CH340N bridge). MicroPython esp32
# port already maps UART0 by default; the strapping circuit on the
# board handles DTR/RTS reset automatically.

# Logging at INFO level for the application; bootloader stays at WARN
# (set in sdkconfig.base).
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL_ERROR=n
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# Pin Wi-Fi/lwIP to PRO_CPU; latency tasks land on APP_CPU. (IDF default
# already places them this way; explicit for documentation.)
CONFIG_ESP_WIFI_TASK_CORE_ID=0

# Enable mDNS responder component (used by annealage_pod.boot in later phases).
# The component itself is only linked when MicroPython references it; we
# do not need a Kconfig flag here.
